{
  "name": "tether",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json}\"",
    "benchmark": "tsx scripts/benchmark.ts",
    "dev": "concurrently -n server,web -c blue,magenta \"npm run dev -w @tether/server\" \"npm run dev -w @tether/web\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "concurrently": "^10.0.5"
  }
}
