# Environment variables read by the server (see packages/server/src/config.ts).
# There is no .env loader: set them in your shell before starting, for example
#   
# Every variable is optional; the values below are the defaults.
PORT=3001
DB_PATH=./data/tether.db
# Pause between streamed chunks in the demo generator (ms). Tests use a manual generator instead.
TOKEN_DELAY_MS=120
# SSE heartbeat interval (ms). 0 disables heartbeats.
HEARTBEAT_MS=15000
# How many of a run's most recent events a client may replay from. 0 = unlimited.
REPLAY_WINDOW=0
# Enables demo-only endpoints such as POST /api/dev/drop-connections.
# Defaults to true unless NODE_ENV=production.
DEMO_MODE=true
