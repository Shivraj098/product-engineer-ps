# Optional. Copy to .env in the repo root and the server will load it automatically
# (via Node's --env-file-if-exists; no dotenv dependency). Nothing here is a secret --
# there is no real model provider, API key, or credential in this project. Every
# variable below has the working default shown; you only need a .env at all if you
# want to override one of them.
PORT=3001
DB_PATH=./data/tether.db
# Pause between streamed chunks in the demo generator (ms). Tests use a manual generator instead.
TOKEN_DELAY_MS=120
# SSE heartbeat interval (ms). 0 disables heartbeats.
HEARTBEAT_MS=15000
# How many of a run's most recent events a client may replay from. 0 = unlimited.
REPLAY_WINDOW=0

# Defaults to true unless NODE_ENV=production.
DEMO_MODE=true
